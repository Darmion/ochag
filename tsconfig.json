{
  "compilerOptions": {
    "target":"ES2023", "module":"NodeNext", "moduleResolution":"NodeNext",
    "strict":true, "noEmit":true, "allowImportingTsExtensions":true,
    "esModuleInterop":true, "skipLibCheck":true, "types":["node"],
    "noUnusedLocals":true, "noUnusedParameters":true
  },
  "include": [
    "apps/server/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "apps/client/test/**/*.ts",
    "apps/client/src/art/itemArt.ts",
    "mods/**/*.ts"
  ]
}
